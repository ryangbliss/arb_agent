# ── Kalshi ──────────────────────────────────────────────────────────────────
# Your Kalshi API key ID (UUID shown in the web console)
KALSHI_KEY_ID=your-uuid-here

# Path to your RSA private key PEM file (downloaded when you created the API key)
# e.g. /Users/yourname/.secrets/kalshi_private_key.pem
KALSHI_PRIVATE_KEY_PATH=/path/to/kalshi_private_key.pem

# ── Anthropic (optional — used for LLM match verification) ───────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Paper-trading config ─────────────────────────────────────────────────────
# Starting simulated cash per venue (dollars)
PAPER_CASH_KALSHI=10000
PAPER_CASH_POLY=10000

# Maximum simulated loss per day before halting (dollars)
MAX_DAILY_LOSS=500

# Maximum simulated position size per market (dollars)
MAX_POSITION_PER_MARKET=200

# Minimum net edge required to simulate a trade (e.g. 0.02 = 2%)
MIN_NET_EDGE=0.02

# Matching confidence threshold (0–1)
MATCH_CONFIDENCE=0.80

# Price-check interval (seconds)
PRICE_CHECK_INTERVAL=60

# Market re-match interval (minutes)
MARKET_REFRESH_MINUTES=30

# Max seconds a quote can be old before being considered stale
STALE_QUOTE_SECONDS=300

# Dashboard port
DASHBOARD_PORT=8765
